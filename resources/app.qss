QMainWindow { background: #f5f7fb; }
QTabWidget::pane { border: 1px solid #dfe3ea; background: white; border-radius: 8px; }
QTabBar::tab { padding: 10px 18px; margin-right: 2px; }
QTabBar::tab:selected { font-weight: 600; }
QPushButton { padding: 7px 13px; border: 1px solid #cdd3dc; border-radius: 6px; background: white; }
QPushButton:hover { background: #eef2f7; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit { padding: 7px; border: 1px solid #cbd2db; border-radius: 6px; background: white; }
QTableWidget { border: 1px solid #dfe3ea; gridline-color: #edf0f4; }
QHeaderView::section { padding: 8px; font-weight: 600; border: 0; border-bottom: 1px solid #dfe3ea; }
QGroupBox { font-weight: 600; border: 1px solid #dfe3ea; border-radius: 8px; margin-top: 8px; padding-top: 12px; background: white; }
QLabel#pageTitle { font-size: 22px; font-weight: 700; margin-bottom: 4px; }
QLabel#metricValue { font-size: 28px; font-weight: 700; }
QLabel#muted { color: #687385; }
QStatusBar { color: #687385; }
QMessageBox { background: white; }
QDialog { background: #f8fafc; }
QTableWidget::item:selected { background: #e8eef8; }
QTableWidget { alternate-background-color: #fafbfc; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus { border: 1px solid #7b92b4; }
QPushButton#danger { color: #a12a2a; }
