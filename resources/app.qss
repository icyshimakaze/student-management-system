/* Light, high-contrast stylesheet. A matching light QPalette is forced in
   main.py so Windows dark mode can never produce invisible text. */

QMainWindow, QDialog { background: #f5f7fb; color: #1a2233; }
QWidget { color: #1a2233; }

QTabWidget::pane {
    border: 1px solid #dfe3ea; background: white; border-radius: 8px;
}
QTabBar::tab {
    padding: 10px 18px; margin-right: 2px;
    color: #1a2233; background: #eef1f6;
    border: 1px solid #dfe3ea; border-bottom: none;
    border-top-left-radius: 6px; border-top-right-radius: 6px;
}
QTabBar::tab:selected { font-weight: 600; background: white; }
QTabBar::tab:hover { background: #e3e8f0; }

QPushButton {
    padding: 7px 13px; border: 1px solid #cdd3dc; border-radius: 6px;
    background: white; color: #1a2233;
}
QPushButton:hover { background: #eef2f7; }
QPushButton:pressed { background: #e2e8f0; }
QPushButton:disabled { color: #9aa2b1; background: #f2f4f7; border-color: #dde1e8; }
QPushButton#danger { color: #a12a2a; }

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    padding: 7px; border: 1px solid #cbd2db; border-radius: 6px;
    background: white; color: #1a2233;
    selection-background-color: #c9d9f5; selection-color: #1a2233;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
    border: 1px solid #7b92b4;
}
QComboBox QAbstractItemView {
    background: white; color: #1a2233;
    selection-background-color: #e8eef8; selection-color: #1a2233;
}

QTableWidget {
    border: 1px solid #dfe3ea; gridline-color: #edf0f4;
    background: white; color: #1a2233;
    alternate-background-color: #fafbfc;
    selection-background-color: #e8eef8; selection-color: #1a2233;
}
QHeaderView::section {
    padding: 8px; font-weight: 600;
    background: #f0f3f8; color: #1a2233;
    border: 0; border-bottom: 1px solid #dfe3ea; border-right: 1px solid #e6eaf1;
}

QGroupBox {
    font-weight: 600; color: #1a2233;
    border: 1px solid #dfe3ea; border-radius: 8px;
    margin-top: 8px; padding-top: 12px; background: white;
}
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; color: #1a2233; }

QLabel#pageTitle { font-size: 22px; font-weight: 700; margin-bottom: 4px; color: #1a2233; }
QLabel#metricValue { font-size: 28px; font-weight: 700; color: #1a2233; }
QLabel#muted { color: #687385; }
QStatusBar { color: #687385; background: #eef1f6; }
QStatusBar QLabel { color: #687385; }

QMenuBar { background: #ffffff; color: #1a2233; border-bottom: 1px solid #dfe3ea; }
QMenuBar::item:selected { background: #eef2f7; }
QMenu { background: white; color: #1a2233; border: 1px solid #dfe3ea; }
QMenu::item:selected { background: #e8eef8; }

QMessageBox { background: white; color: #1a2233; }
QMessageBox QLabel { color: #1a2233; }

QScrollBar:vertical { background: #f2f4f7; width: 12px; }
QScrollBar::handle:vertical { background: #c7cdd8; border-radius: 6px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #aeb6c4; }
QScrollBar:horizontal { background: #f2f4f7; height: 12px; }
QScrollBar::handle:horizontal { background: #c7cdd8; border-radius: 6px; min-width: 30px; }

QDoubleSpinBox::up-button, QSpinBox::up-button,
QDateEdit::up-button, QDoubleSpinBox::down-button,
QSpinBox::down-button, QDateEdit::down-button { background: #eef2f7; }
