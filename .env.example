# Desktop app + scripts
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=student_management

# Integration tests (optional; tests skip when unreachable)
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3306
# TEST_DB_USER=root
# TEST_DB_PASSWORD=
# TEST_DB_NAME=student_management_test

# REST API (api.py) — required only when running the API.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# API_JWT_SECRET=
# API_TOKEN_TTL_MINUTES=120

# Extra browser origins allowed to call the API (comma-separated).
# Only needed when the frontend is served from a different origin in production.
# CORS_ORIGINS=https://your-frontend.example.com

# Frontend (sms-web) — URL of the FastAPI backend the browser calls.
# Development default is http://127.0.0.1:8000 (Vite reads VITE_* at build time).
# VITE_API_URL=http://127.0.0.1:8000
